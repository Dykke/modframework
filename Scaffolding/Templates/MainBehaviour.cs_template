        // Called when the mod is activated (toggled on by player)
        public override void OnActivate()
        {
            Debug.Log("[{MOD_NAME}] Activated.");

            // ---------------------------------------------------------------
            // Soft-dependency re-check (Q2 decision).
            //
            // Hard-required deps are checked in {MOD_NAME}Meta.Initialize.
            // Re-check optional ones here so we can warn when the player
            // activates the mod without something it could benefit from.
            // ---------------------------------------------------------------
            ModDependencies.VerifyOrWarn(ParentMod,
                new ModDependency
                {
                    Name = "SomeOptionalMod",
                    Kind = ModDependencyKind.Mod,
                    Severity = ModDependencySeverity.Optional
                }
            );

