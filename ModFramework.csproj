<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{B8E9F7A2-1234-5678-9ABC-DEF012345678}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>ModFramework</RootNamespace>
    <AssemblyName>ModFramework</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <!-- Strong-name signing (v6.0). The keypair lives at ../../_secure/ModFramework.snk (gitignored).
         The public key is committed at keys/ModFramework.pub. Build-ModFramework.ps1 cross-checks
         the .pub matches the .snk before building. See modframework/keys/README.md. -->
    <AssemblyOriginatorKeyFile>..\_secure\ModFramework.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>E:\SteamLibrary\steamapps\common\Software Inc\Software Inc_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="UnityEngine">
      <HintPath>E:\SteamLibrary\steamapps\common\Software Inc\Software Inc_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>E:\SteamLibrary\steamapps\common\Software Inc\Software Inc_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- v6.1.1: JsonUtility lives in this module on Unity 2018.4, not CoreModule. -->
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>E:\SteamLibrary\steamapps\common\Software Inc\Software Inc_Data\Managed\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>E:\SteamLibrary\steamapps\common\Software Inc\Software Inc_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>E:\SteamLibrary\steamapps\common\Software Inc\Software Inc_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>E:\SteamLibrary\steamapps\common\Software Inc\Software Inc_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>E:\SteamLibrary\steamapps\common\Software Inc\Software Inc_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>E:\SteamLibrary\steamapps\common\Software Inc\Software Inc_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>Harmony\0Harmony.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- v6.1.1: Newtonsoft.Json reference removed. JSON now uses Unity's native
         JsonUtility (see Core/ModFileAccess.cs). Newtonsoft 13.0.3 failed its
         JsonWriter static init under Unity 2018.4 Mono, breaking all WriteJson. -->
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ModFramework.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <!-- v6.0 security foundation (Phase 0) — 11 new type skeletons + 1 attribute.
         The v5.x subfolder entries (ModFileAccess, ModHarmony, etc.) are still
         temporarily disabled below to keep the v4.x single-file layout working
         for MoreCompanies v3.0. They will be re-enabled + reworked to take
         ModIdentity + SafePath in Phase 1. -->
    <Compile Include="Core\ModFrameworkPublicAPI.cs" />
    <Compile Include="Core\ModIdentity.cs" />
    <Compile Include="Core\SafePath.cs" />
    <Compile Include="Core\EventKey.cs" />
    <Compile Include="Core\ServiceToken.cs" />
    <Compile Include="Core\Permission.cs" />
    <Compile Include="Core\PermissionPresets.cs" />
    <Compile Include="Core\PermissionParser.cs" />
    <Compile Include="Core\ModSecurityException.cs" />
    <Compile Include="Core\ModPathException.cs" />
    <Compile Include="Core\ModPermissionException.cs" />
    <Compile Include="Core\AuditLog.cs" />
    <!-- v6.0 P0 layer (Phase 1): ModRegistry + signature check + activator + guards -->
    <Compile Include="Core\ModRegistry.cs" />
    <Compile Include="Core\FrameworkSignatureCheck.cs" />
    <Compile Include="Core\ModFrameworkActivator.cs" />
    <Compile Include="Core\SecurityGuards.cs" />
    <!-- v6.0 re-enabled v5.x subfolder files. Now includes D5 ModServiceHost/Bridge (ServiceToken). -->
    <Compile Include="Core\ModFileAccess.cs" />
    <Compile Include="Core\ModHarmony.cs" />
    <Compile Include="Core\ModServiceBridge.cs" />
    <!-- v6.0 D4: ModEvents v6.0 (EventKey + per-op permission + global whitelist). -->
    <Compile Include="Core\ModEvents.cs" />
    <!-- v6.0 re-enabled v5.x utility files (Phase 2 follow-ups).
         ModSafety, ModUtils, ModDependencies, ModLoader are all marked
         [ModFrameworkPublicAPI("v6.0")] and are read-only utilities
         (no permission check needed). ModDependencies has audit-log
         hooks on ShowMissingMessage. -->
    <Compile Include="Core\ModSafety.cs" />
    <Compile Include="Core\ModUtils.cs" />
    <Compile Include="Core\ModDependencies.cs" />
    <Compile Include="Core\ModLoader.cs" />
    <Compile Include="UI\ModFrameworkSettingsWindow.cs" />
    <!-- v5.x subfolder entries still disabled: GameData/ and UI/ helpers
         are not part of the v6.0 API surface. They will be re-enabled
         when a consuming mod actually needs them. -->
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  <!--
    ====================================================================
    ILMerge post-build step
    ====================================================================
    Merges 0Harmony.dll and Newtonsoft.Json.dll INTO ModFramework.dll so
    that mods can ship a single DLL (no Dependencies folder, Steam-Workshop
    safe).

    To enable:
      1. Download ILMerge from
         https://www.nuget.org/packages/ilmerge/
         (extract ILMerge.exe to Tools/ilmerge/ILMerge.exe)
      2. Set <ILMergePath>Tools\ilmerge\ILMerge.exe</ILMergePath> below
         or define it as an environment variable.

    To skip ILMerge (e.g. while developing the framework itself), delete
    this <Target> block or set <ILMergeEnabled>false</ILMergeEnabled>.

    After ILMerge runs, the standalone 0Harmony.dll and Newtonsoft.Json.dll
    in $(OutDir) are removed — the merged ModFramework.dll is the only
    output.

    NOTE: Mods built against the merged ModFramework.dll do NOT need to
    reference 0Harmony.dll or Newtonsoft.Json.dll. They just reference
    ModFramework.dll and everything Just Works.
    ====================================================================
  -->
  <PropertyGroup>
    <ILMergeEnabled Condition=" '$(ILMergeEnabled)' == '' ">true</ILMergeEnabled>
    <ILMergePath Condition=" '$(ILMergePath)' == '' ">$(MSBuildProjectDirectory)\Tools\ilmerge\ILMerge.exe</ILMergePath>
    <!-- Game's Managed folder — ILMerge needs this in /lib: so it can resolve UnityEngine.* and Assembly-CSharp references at merge time -->
    <ManagedDir Condition=" '$(ManagedDir)' == '' ">E:\SteamLibrary\steamapps\common\Software Inc\Software Inc_Data\Managed</ManagedDir>
  </PropertyGroup>
  <Target Name="ILMergeAssemblies" AfterTargets="Build" Condition="'$(ILMergeEnabled)' == 'true' AND Exists('$(ILMergePath)') AND '$(Configuration)' == 'Release'">
    <Message Text="=== ILMerge step: merging 0Harmony INTO ModFramework.dll ===" Importance="high" />
    <Exec Command="&quot;$(ILMergePath)&quot; /lib:&quot;$(ManagedDir)&quot; /keyfile:&quot;$(MSBuildProjectDirectory)\..\_secure\ModFramework.snk&quot; /out:&quot;$(OutDir)ModFramework.dll&quot; /targetplatform:v4 /internalize:&quot;$(MSBuildProjectDirectory)\Tools\ilmerge\ilmerge.exclude&quot; &quot;$(OutDir)ModFramework.dll&quot; &quot;$(OutDir)0Harmony.dll&quot;" />
    <Delete Files="$(OutDir)0Harmony.dll" />
    <Message Text="=== ILMerge complete. ModFramework.dll is the single shippable artifact. ===" Importance="high" />
  </Target>
  <Target Name="ILMergeWarning" AfterTargets="Build" Condition="'$(ILMergeEnabled)' == 'true' AND '$(Configuration)' == 'Release' AND !Exists('$(ILMergePath)')">
    <Warning Text="ILMerge is enabled but ILMerge.exe was not found at $(ILMergePath). Skipping merge — output will be multi-DLL. See Tools/ilmerge/README.md for setup." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>