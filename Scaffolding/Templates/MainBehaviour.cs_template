        // Called when the mod is activated (toggled on by player)
        public override void OnActivate()
        {
            Debug.Log("[{MOD_NAME}] Activated.");

            // ---------------------------------------------------------------
            // Optional addendum DLL — re-check at activation / GameReady.
            // Do NOT cache IsPresent at Initialize; the dependency may activate later.
            // ---------------------------------------------------------------
            var nativeFeature = new ModDependency
            {
                Name = "MyMod - Native Feature",
                FolderName = "MyModDependency",
                ServiceObjectName = "MyModNativeService",
                Kind = ModDependencyKind.Mod,
                Severity = ModDependencySeverity.Optional
            };

            ModDependencies.VerifyOrWarn(ParentMod, nativeFeature);

            ModServiceBridge.WhenDependencyReady(ParentMod, nativeFeature, delegate(bool ready)
            {
                if (ready)
                    Debug.Log("[{MOD_NAME}] Optional native feature is available.");
                else
                    Debug.Log("[{MOD_NAME}] Optional native feature not installed — reduced functionality.");
            });

            // At use time (button click, etc.):
